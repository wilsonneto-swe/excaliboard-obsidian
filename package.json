{
  "name": "excaliboard",
  "version": "0.3.0",
  "private": true,
  "description": "Draw in your vault with the Excalidraw editor. Each drawing stays a plain .excalidraw file that excalidraw.com opens, written only when you change it.",
  "author": "Wilson Neto",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "vitest run",
    "lint": "eslint .",
    "notices": "node scripts/third-party-notices.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run notices -- --check && npm run build"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "file:./stubs/mermaid-to-excalidraw",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.5.1",
    "jsdom": "31.0.0",
    "obsidian": "1.14.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@excalidraw/mermaid-to-excalidraw": "$@excalidraw/mermaid-to-excalidraw",
    "nanoid@<3.3.18": "3.3.20",
    "eslint-plugin-obsidianmd": {
      "obsidian": "$obsidian"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wilsonneto-swe/excaliboard-obsidian.git"
  }
}
